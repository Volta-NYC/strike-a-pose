# Server-only values. Set in Vercel, or an ignored .env.local for local development.
# Never prefix these names with NEXT_PUBLIC_.
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Use the PEM private key, with actual newlines or escaped \n sequences.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_your_private_key\n-----END PRIVATE KEY-----\n"
